<section class="hero">
  <div class="container hero-content">
    <div class="badge badge-blue">Windows & Android</div>
    <h1 class="hero-title">Pullar</h1>
    <p class="hero-slogan">Don't just watch—pull it</p>
    <p class="hero-description">
      Segmented video and audio downloader with built-in media playback.
    </p>
  </div>
</section>

<style>
  .hero {
    padding: 70px 0 40px;
    text-align: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-title {
    font-size: clamp(52px, 8vw, 88px);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--light-apricot);
    margin: 16px 0 8px;
  }

  .hero-slogan {
    font-size: clamp(20px, 3.5vw, 28px);
    font-weight: 700;
    color: var(--maya-blue);
    margin-bottom: 12px;
  }

  .hero-description {
    font-size: 16px;
    color: var(--text-muted);
    max-width: 520px;
  }
</style>
