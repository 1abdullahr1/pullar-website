---
---

<section class="features-section">
  <div class="container">
    <div class="features-grid">
      <!-- Feature 1: Speed -->
      <div class="feature-pill glass-card">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feature-icon">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
        </svg>
        <div class="feature-text">
          <span class="feature-name">16x Segmented</span>
          <span class="feature-sub">Multi-connection speed</span>
        </div>
      </div>

      <!-- Feature 2: Player -->
      <div class="feature-pill glass-card">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feature-icon">
          <circle cx="12" cy="12" r="10"/>
          <polygon points="10 8 16 12 10 16 10 8"/>
        </svg>
        <div class="feature-text">
          <span class="feature-name">Built-in Player</span>
          <span class="feature-sub">Instant playback</span>
        </div>
      </div>

      <!-- Feature 3: Playlists -->
      <div class="feature-pill glass-card">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feature-icon">
          <line x1="8" y1="6" x2="21" y2="6"/>
          <line x1="8" y1="12" x2="21" y2="12"/>
          <line x1="8" y1="18" x2="21" y2="18"/>
          <line x1="3" y1="6" x2="3.01" y2="6"/>
          <line x1="3" y1="12" x2="3.01" y2="12"/>
          <line x1="3" y1="18" x2="3.01" y2="18"/>
        </svg>
        <div class="feature-text">
          <span class="feature-name">Full Playlists</span>
          <span class="feature-sub">Batch extraction</span>
        </div>
      </div>

      <!-- Feature 4: Open Source -->
      <div class="feature-pill glass-card">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feature-icon">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        <div class="feature-text">
          <span class="feature-name">Open Source</span>
          <span class="feature-sub">Free under MIT</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .features-section {
    padding: 20px 0 60px;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }

  .feature-pill {
    padding: 20px 18px;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .feature-icon {
    color: var(--maya-blue);
    flex-shrink: 0;
  }

  .feature-text {
    display: flex;
    flex-direction: column;
  }

  .feature-name {
    font-size: 15px;
    font-weight: 700;
    color: var(--light-apricot);
  }

  .feature-sub {
    font-size: 12px;
    color: var(--text-muted);
  }
</style>
